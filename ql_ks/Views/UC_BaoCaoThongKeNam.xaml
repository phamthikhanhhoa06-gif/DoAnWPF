<UserControl x:Class="ql_ks.Views.UC_BaoCaoThongKeNam"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ql_ks.Views"
             mc:Ignorable="d" 
          d:DesignHeight="700" d:DesignWidth="1200"
             Background="#F5F7FA">

    <UserControl.Resources>
        <Style x:Key="CenterAlign" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="RightAlign" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="PHẦN MỀM QUẢN LÍ KHÁCH SẠN" 
                   FontSize="26" FontWeight="Bold" Foreground="#30324A" 
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="#E5E7EB" 
                BorderThickness="1" Padding="15" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Năm báo cáo:" VerticalAlignment="Center" 
                           Margin="0,0,8,0" Foreground="#555" FontWeight="Bold"/>
                <ComboBox ItemsSource="{Binding NamList}" 
                          SelectedItem="{Binding NamChon}"
                          Width="100" Height="32" Margin="0,0,20,0"/>
                <Button Content="🔍" Command="{Binding TimKiemCommand}" 
                        Background="#3498DB" Foreground="White" 
                        Width="36" Height="32" BorderThickness="0" 
                        FontSize="16" Cursor="Hand" Margin="0,0,10,0"/>
                <Button Content="🖨️ Xuất / In báo cáo" Click="BtnXuatBaoCao_Click"
                        Background="#E74C3C" Foreground="White" Padding="15,6" 
                        BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="12" 
                BorderBrush="#E5E7EB" BorderThickness="1" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" 
                              Margin="0,0,15,0">
                    <StackPanel>
                        <TextBlock Text="CHI TIẾT DOANH THU THEO THÁNG" 
                                   FontSize="16" FontWeight="Bold" 
                                   Foreground="#2C3E50" Margin="0,0,0,10"/>
                        <DataGrid ItemsSource="{Binding ChiTietThangList}" 
                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                  IsReadOnly="True" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal" 
                                  Background="White" RowHeight="35"
                                  AlternatingRowBackground="#F8F9FA">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tháng" 
                                                    Binding="{Binding TenThang}" Width="*"/>
                                <DataGridTextColumn Header="Doanh thu (VNĐ)" 
                                                    Binding="{Binding DoanhThu, StringFormat={}{0:N0}}" 
                                                    Width="140" ElementStyle="{StaticResource RightAlign}"/>
                                <DataGridTextColumn Header="Tỷ lệ" 
                                                    Binding="{Binding TyLe, StringFormat={}{0:P2}}" 
                                                    Width="90" ElementStyle="{StaticResource CenterAlign}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock FontSize="18" Foreground="#555" 
                                   HorizontalAlignment="Center" Margin="0,0,0,5">
                            <Run Text="Tổng doanh thu năm: "/>
                            <Run Text="{Binding TongDoanhThuNam, StringFormat={}{0:N0}}" 
                                 FontWeight="Bold" Foreground="#E74C3C"/>
                        </TextBlock>
                        <TextBlock Text="(Đơn vị tính: VNĐ)" FontSize="12" Foreground="#999" 
                                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

                        <Border Background="#F8F9FA" CornerRadius="8" Padding="15,10" Margin="0,0,0,10">
                            <Grid Height="280">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- ItemsControl với UniformGrid để 12 tháng luôn vừa -->
                                <ItemsControl Grid.Row="0" ItemsSource="{Binding BieuDoNamList}" 
                      VerticalAlignment="Bottom">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="12" Rows="1"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="2,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Cột doanh thu - MinHeight 15px để luôn nhìn thấy -->
                                                <Border Grid.Row="0" Background="{Binding Mau}" 
                                Height="{Binding ChieuCaoBar}"
                                VerticalAlignment="Bottom"
                                CornerRadius="4,4,0,0" 
                                MinHeight="15"
                                Margin="0,0,0,5">
                                                    <Border.ToolTip>
                                                        <ToolTip>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding TenThangDayDu}" FontWeight="Bold"/>
                                                                <TextBlock Text="{Binding DoanhThu, StringFormat='{}{0:N0} VNĐ'}"/>
                                                                <TextBlock Text="{Binding TyLe, StringFormat='Tỷ lệ: {0:P1}'}"/>
                                                            </StackPanel>
                                                        </ToolTip>
                                                    </Border.ToolTip>

                                                    <!-- Hiển thị giá trị trên cột nếu đủ cao -->
                                                    <TextBlock Text="{Binding DoanhThu, StringFormat={}{0:N0}}" 
                                       FontSize="9" Foreground="White" 
                                       HorizontalAlignment="Center" VerticalAlignment="Top"
                                       Margin="0,2,0,0" Visibility="{Binding ShowValue}"/>
                                                </Border>

                                                <!-- Label tháng -->
                                                <TextBlock Grid.Row="1" Text="{Binding Thang}" 
                                   FontSize="11" Foreground="#555" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>