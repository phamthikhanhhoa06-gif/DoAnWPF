<UserControl x:Class="ql_ks.Views.UC_HoaDonGiatUi"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ql_ks.Views"
             mc:Ignorable="d" 
            d:DesignHeight="650" d:DesignWidth="750"
             Background="#F5F7FA">

    <UserControl.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#7F8C8D"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="BorderBrush" Value="#DDD"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style x:Key="DatePickerStyle" TargetType="DatePicker">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ====== TIÊU ĐỀ ====== -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,20">
            <TextBlock Text="HÓA ĐƠN GIẶT ỦI" FontSize="22" FontWeight="Bold" 
                       Foreground="#2C3E50" HorizontalAlignment="Center"/>
            <Rectangle Height="3" Width="200" Fill="#3498DB" 
                       HorizontalAlignment="Center" Margin="0,5,0,0"/>
            <TextBlock Text="{Binding ThongBao}" FontSize="12" Foreground="#999" 
                       HorizontalAlignment="Center" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- ====== NỘI DUNG ====== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ====== CỘT TRÁI ====== -->
                <StackPanel Grid.Column="0">

                    <TextBlock Text="THÔNG TIN HÓA ĐƠN" FontSize="14" FontWeight="Bold" 
                               Foreground="#2C3E50" Margin="0,0,0,15"/>
                    <Separator Background="#E0E0E0" Margin="0,0,0,15"/>

                    <!-- Mã hóa đơn -->
                    <TextBlock Text="Mã hóa đơn" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Text="{Binding MaHD}" Style="{StaticResource ValueStyle}"/>

                    <!-- Ngày lập -->
                    <TextBlock Text="Ngày lập hóa đơn" Style="{StaticResource LabelStyle}"/>
                    <DatePicker SelectedDate="{Binding NgayLapHD}" 
                                Style="{StaticResource DatePickerStyle}"/>

                    <!-- Giờ lập -->
                    <TextBlock Text="Giờ lập hóa đơn" Style="{StaticResource LabelStyle}"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding GioLapHD}" 
                                   FontSize="14" FontWeight="SemiBold" 
                                   Foreground="#2C3E50" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="🕐" Background="Transparent" 
                                BorderThickness="0" FontSize="18" Cursor="Hand"
                                Click="BtnCapNhatGio_Click"/>
                    </Grid>

                    <!-- Nhân viên -->
                    <TextBlock Text="Nhân viên lập" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Text="{Binding TenNhanVien}" Style="{StaticResource ValueStyle}"/>

                    <Separator Background="#E0E0E0" Margin="0,5,0,15"/>

                    <!-- THÔNG TIN KHÁCH HÀNG -->
                    <TextBlock Text="THÔNG TIN KHÁCH HÀNG" FontSize="14" FontWeight="Bold" 
                               Foreground="#2C3E50" Margin="0,0,0,15"/>

                    <TextBlock Text="Họ và tên" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Text="{Binding TenKhachHang}" Style="{StaticResource ValueStyle}"/>

                    <TextBlock Text="Số điện thoại" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Text="{Binding SoDienThoaiKH}" Style="{StaticResource ValueStyle}"/>

                    <TextBlock Text="CMND / CCCD" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Text="{Binding CMND}" Style="{StaticResource ValueStyle}"/>
                </StackPanel>

                <!-- ====== CỘT PHẢI ====== -->
                <StackPanel Grid.Column="2">

                    <TextBlock Text="THÔNG TIN THANH TOÁN" FontSize="14" FontWeight="Bold" 
                               Foreground="#2C3E50" Margin="0,0,0,15"/>
                    <Separator Background="#E0E0E0" Margin="0,0,0,15"/>

                    <!-- Mã phòng -->
                    <TextBlock Text="Mã phòng" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Text="{Binding MaPhong}" Style="{StaticResource ValueStyle}" 
                               FontSize="20"/>

                    <!-- Loại giặt ủi -->
                    <TextBlock Text="Loại giặt ủi" Style="{StaticResource LabelStyle}"/>
                    <ComboBox ItemsSource="{Binding LoaiGiatUiList}" 
                              SelectedItem="{Binding SelectedLoaiGU}"
                              DisplayMemberPath="Ten_LoaiGU"
                              FontSize="14" Margin="0,0,0,12" Padding="8,5"/>

                    <!-- Theo kilogram -->
                    <TextBlock Text="{Binding TheoKilogram}" 
                               Style="{StaticResource ValueStyle}" Foreground="#3498DB"/>

                    <!-- Đơn giá -->
                    <TextBlock Text="Đơn giá" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Text="{Binding DonGiaText}" Style="{StaticResource ValueStyle}"/>

                    <!-- Số kilogram (NÚT 1: Nhập khối lượng) -->
                    <TextBlock Text="Số kilogram" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding SoKgText, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource InputStyle}"
                             FontSize="18" FontWeight="Bold"/>

                    <Separator Background="#E0E0E0" Margin="0,5,0,15"/>

                    <!-- Ngày bắt đầu -->
                    <TextBlock Text="Ngày bắt đầu" Style="{StaticResource LabelStyle}"/>
                    <DatePicker SelectedDate="{Binding NgayBatDau}" 
                                Style="{StaticResource DatePickerStyle}"/>

                    <!-- Ngày kết thúc -->
                    <TextBlock Text="Ngày kết thúc" Style="{StaticResource LabelStyle}"/>
                    <DatePicker SelectedDate="{Binding NgayKetThuc}" 
                                Style="{StaticResource DatePickerStyle}"/>

                    <Separator Background="#E0E0E0" Margin="0,5,0,15"/>

                    <!-- TỔNG TIỀN -->
                    <TextBlock Text="Tổng cộng" FontSize="14" FontWeight="Bold" 
                               Foreground="#E74C3C" Margin="0,0,0,5"/>

                    <Border Background="#FDEDEC" CornerRadius="8" Padding="15,10">
                        <TextBlock FontSize="24" FontWeight="Bold" 
                                   Foreground="#E74C3C" HorizontalAlignment="Center">
                            <Run Text="{Binding TongTien}"/>
                            <Run Text=" VNĐ" FontSize="14"/>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- ====== NÚT DƯỚI ====== -->
        <Border Grid.Row="2" Margin="0,15,0,0" Padding="0,10,0,0"
                BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Nút 2: Hủy -->
                <Button Grid.Column="0" Content="Hủy" 
                        Command="{Binding HuyCommand}"
                        HorizontalAlignment="Left"
                        Background="#95A5A6" Foreground="White" 
                        Padding="25,10" FontSize="14" FontWeight="Bold"
                        BorderThickness="0" Cursor="Hand"/>

                <!-- Nút 3: Lưu -->
                <Button Grid.Column="1" Content="Lưu" 
                        Command="{Binding LuuCommand}"
                        Background="#3498DB" Foreground="White" 
                        Padding="25,10" FontSize="14" FontWeight="Bold"
                        BorderThickness="0" Cursor="Hand"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>