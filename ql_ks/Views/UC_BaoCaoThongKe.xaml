<UserControl x:Class="ql_ks.Views.UC_BaoCaoThongKe"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             TextElement.FontWeight="Regular"
             TextElement.FontSize="13"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="Auto"
             Background="{DynamicResource MaterialDesignPaper}"
             FontFamily="{DynamicResource MaterialDesignFont}">
             
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" Text="BÁO CÁO &amp; THỐNG KÊ" FontSize="24" FontWeight="Bold" Foreground="#3F51B5" Margin="0,0,0,20"/>
        
        <TabControl Grid.Row="1" Style="{StaticResource MaterialDesignFilledTabControl}">
            <!-- TAB DOANH THU NĂM -->
            <TabItem Header="BÁO CÁO NĂM" Height="50" FontSize="14">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,10,0,20">
                        <TextBox Text="{Binding NamBaoCao}" 
                                 materialDesign:HintAssist.Hint="Nhập Năm (VD: 2024)" 
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                                 Width="150" Margin="0,0,20,0"/>
                                 
                        <Button Command="{Binding LapBaoCaoNamCommand}" 
                                Content="LẬP BÁO CÁO" 
                                Width="150" Height="40" Background="#2C3E50" BorderBrush="#2C3E50"/>
                    </StackPanel>

                    <!-- Biểu đồ Cột (Bar Chart) tự chế -->
                    <materialDesign:Card Grid.Row="1" Padding="15" Margin="0,0,0,20" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="{Binding NamBaoCao, StringFormat=Biểu đồ doanh thu năm {0}}" FontWeight="Bold" FontSize="16" Margin="0,0,0,20"/>
                            
                            <ItemsControl ItemsSource="{Binding ChartItems}" Height="250">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="5,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            
                                            <!-- Cột Bar -->
                                            <Border Grid.Row="0" Width="30" VerticalAlignment="Bottom"
                                                    Height="{Binding ScaledHeight}" 
                                                    Background="#3F51B5" CornerRadius="4,4,0,0"
                                                    ToolTip="{Binding DisplayValue}"/>
                                                    
                                            <!-- Tên tháng -->
                                            <TextBlock Grid.Row="1" Text="{Binding Label}" 
                                                       HorizontalAlignment="Center" Margin="0,5,0,0" 
                                                       FontWeight="SemiBold" FontSize="12"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            
                            <!-- Legend -->
                            <TextBlock Text="(Đơn vị: VNĐ - Trỏ chuột vào cột để xem số tiền cụ thể)" 
                                       FontStyle="Italic" Foreground="Gray" FontSize="11" 
                                       HorizontalAlignment="Right" Margin="0,10,0,0"/>
                        </StackPanel>
                    </materialDesign:Card>
                    
                    <materialDesign:Card Grid.Row="1" Padding="10" Margin="0,350,0,0">
                        <DataGrid ItemsSource="{Binding ListBaoCaoNam}" 
                                  AutoGenerateColumns="False" 
                                  IsReadOnly="True"
                                  materialDesign:DataGridAssist.CellPadding="10">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Năm" Binding="{Binding NAM_BCN}" FontWeight="Bold"/>
                                <DataGridTextColumn Header="Tổng Năm" Binding="{Binding TONGDOANHTHU_BCN, StringFormat={}{0:N0} đ}" Foreground="Red" FontWeight="Bold"/>
                                <DataGridTextColumn Header="Tháng 1" Binding="{Binding DOANHTHUTHANG1_BCN, StringFormat={}{0:N0}}"/>
                                <DataGridTextColumn Header="Tháng 2" Binding="{Binding DOANHTHUTHANG2_BCN, StringFormat={}{0:N0}}"/>
                                <DataGridTextColumn Header="Tháng 3" Binding="{Binding DOANHTHUTHANG3_BCN, StringFormat={}{0:N0}}"/>
                                <DataGridTextColumn Header="Tháng 4" Binding="{Binding DOANHTHUTHANG4_BCN, StringFormat={}{0:N0}}"/>
                                <DataGridTextColumn Header="Tháng 5" Binding="{Binding DOANHTHUTHANG5_BCN, StringFormat={}{0:N0}}"/>
                                <DataGridTextColumn Header="Tháng 6" Binding="{Binding DOANHTHUTHANG6_BCN, StringFormat={}{0:N0}}"/>
                                <DataGridTextColumn Header="Tháng 7" Binding="{Binding DOANHTHUTHANG7_BCN, StringFormat={}{0:N0}}"/>
                                <DataGridTextColumn Header="Tháng 8" Binding="{Binding DOANHTHUTHANG8_BCN, StringFormat={}{0:N0}}"/>
                                <DataGridTextColumn Header="Tháng 9" Binding="{Binding DOANHTHUTHANG9_BCN, StringFormat={}{0:N0}}"/>
                                <DataGridTextColumn Header="Tháng 10" Binding="{Binding DOANHTHUTHANG10_BCN, StringFormat={}{0:N0}}"/>
                                <DataGridTextColumn Header="Tháng 11" Binding="{Binding DOANHTHUTHANG11_BCN, StringFormat={}{0:N0}}"/>
                                <DataGridTextColumn Header="Tháng 12" Binding="{Binding DOANHTHUTHANG12_BCN, StringFormat={}{0:N0}}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </materialDesign:Card>
                </Grid>
            </TabItem>
            
            <!-- TAB DỊCH VỤ -->
            <TabItem Header="BÁO CÁO DỊCH VỤ" Height="50" FontSize="14">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,10,0,20">
                        <DatePicker SelectedDate="{Binding TuNgay}" 
                                    materialDesign:HintAssist.Hint="Từ ngày" 
                                    Style="{StaticResource MaterialDesignFloatingHintDatePicker}" 
                                    Width="150" Margin="0,0,20,0"/>
                                    
                        <DatePicker SelectedDate="{Binding DenNgay}" 
                                    materialDesign:HintAssist.Hint="Đến ngày" 
                                    Style="{StaticResource MaterialDesignFloatingHintDatePicker}" 
                                    Width="150" Margin="0,0,20,0"/>
                                 
                        <Button Command="{Binding LapBaoCaoDichVuCommand}" 
                                Content="LẬP BÁO CÁO DỊCH VỤ" 
                                Height="40" Background="#2C3E50" BorderBrush="#2C3E50" Padding="15,0"/>
                    </StackPanel>
                    
                    <materialDesign:Card Grid.Row="1" Padding="10">
                        <DataGrid ItemsSource="{Binding ListBaoCaoDichVu}" 
                                  AutoGenerateColumns="False" 
                                  IsReadOnly="True"
                                  materialDesign:DataGridAssist.CellPadding="10">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã BC" Binding="{Binding MA_BCDV}"/>
                                <DataGridTextColumn Header="Từ ngày" Binding="{Binding NGAYBATDAU_BCDV, StringFormat=dd/MM/yyyy}"/>
                                <DataGridTextColumn Header="Đến ngày" Binding="{Binding NGAYKETTHUC_BCDV, StringFormat=dd/MM/yyyy}"/>
                                <DataGridTextColumn Header="Tổng cộng" Binding="{Binding TONGDOANHTHU_BCDV, StringFormat={}{0:N0} đ}" FontWeight="Bold" Foreground="Red"/>
                                <DataGridTextColumn Header="Lưu trú" Binding="{Binding DOANHTHULUUUTRU_BCDV, StringFormat={}{0:N0} đ}"/>
                                <DataGridTextColumn Header="Ăn uống" Binding="{Binding DOANHTHUANUONG_BCDV, StringFormat={}{0:N0} đ}"/>
                                <DataGridTextColumn Header="Giặt ủi" Binding="{Binding DOANHTHUGIATUI_BCDV, StringFormat={}{0:N0} đ}"/>
                                <DataGridTextColumn Header="Di chuyển" Binding="{Binding DOANHTHUDICHUYEN_BCDV, StringFormat={}{0:N0} đ}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </materialDesign:Card>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
