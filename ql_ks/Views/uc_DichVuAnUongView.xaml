<UserControl x:Class="ql_ks.Views.uc_DichVuAnUongView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ql_ks.Views"
             mc:Ignorable="d"
             d:DesignHeight="750"
             d:DesignWidth="1000">

    <Grid Margin="20" Background="#F5F7FB">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="White"
                Padding="15"
                CornerRadius="8"
                Margin="0,0,0,15"
                BorderBrush="#E5E7EB"
                BorderThickness="1">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,10,0,16">
                    <TextBlock Text="PHẦN MỀM QUẢN LÍ KHÁCH SẠN" FontSize="26" FontWeight="Bold" Foreground="#30324A"/>
                    <TextBlock Text="DỊCH VỤ ĂN UỐNG" FontSize="16" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

               

                <!-- Tổng tiền -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <TextBlock FontSize="18"
                               FontWeight="Bold"
                               Foreground="OrangeRed"
                               VerticalAlignment="Center">
                        <Run Text="Tổng: "/>
                        <Run Text="{Binding TongTien, StringFormat={}{0:N0}}"/>
                        <Run Text=" ₫"/>
                    </TextBlock>

                    <Button Content="💾 Gửi Đơn"
                            Command="{Binding SaveCommand}"
                            Background="#2ECC71"
                            Foreground="White"
                            Padding="20,8"
                            Margin="15,0,0,0"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CONTENT -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="550"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
        Background="White"
        BorderBrush="#E5E7EB"
        BorderThickness="1"
        CornerRadius="8"
        Padding="12">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Mã phòng -->
                    <!-- Mã phòng + thông báo lỗi -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Mã phòng:"
                   FontWeight="Bold"
                   VerticalAlignment="Center"
                   Foreground="#333"
                   Margin="0,0,8,0"/>

                            <TextBox Text="{Binding MaPhong, UpdateSourceTrigger=PropertyChanged}"
                 Width="100"
                 Height="32"
                 MaxLength="3"
                 Padding="8,3,8,3"
                 VerticalContentAlignment="Center"
                 Background="#F9FAFB"
                 BorderThickness="1">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CoLoiMaPhong}" Value="True">
                                                <Setter Property="BorderBrush" Value="Red"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                                <Setter Property="Background" Value="#FFF5F5"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </StackPanel>

                        <!-- Thông báo lỗi mã phòng -->
                        <TextBlock Text="{Binding LoiMaPhong}"
               Foreground="Red"
               FontSize="12"
               FontStyle="Italic"
               Margin="0,4,0,0"
               TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CoLoiMaPhong}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <!-- Tiêu đề + tìm kiếm -->
                    <!-- Tiêu đề + tìm kiếm -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,10">
                        <TextBlock Text="THỰC ĐƠN"
               FontSize="18"
               FontWeight="Bold"
               Foreground="#222"
               Margin="0,0,0,10"/>

                        <TextBox Text="{Binding TuKhoaTimKiem, UpdateSourceTrigger=PropertyChanged}"
             Height="34"
             Padding="10,4"
             Background="#F9FAFB"
             BorderThickness="1"
             ToolTip="Tìm kiếm theo tên món">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CoLoiTimKiem}" Value="True">
                                            <Setter Property="BorderBrush" Value="Red"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                            <Setter Property="Background" Value="#FFF5F5"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <!-- Thông báo lỗi tìm kiếm -->
                        <TextBlock Text="{Binding LoiTimKiem}"
               Foreground="Red"
               FontSize="12"
               FontStyle="Italic"
               Margin="0,4,0,0"
               TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CoLoiTimKiem}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <!-- Danh sách thực đơn có thanh kéo -->
                    <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Visible"
                      HorizontalScrollBarVisibility="Disabled">

                        <ItemsControl ItemsSource="{Binding DanhSachMonAn}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                CornerRadius="6"
                                Margin="0,0,0,8"
                                Padding="10">

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Ten_MH}"
                                               FontWeight="Bold"
                                               Foreground="#333"
                                               FontSize="14"
                                               TextWrapping="Wrap"/>

                                                <TextBlock Foreground="Gray"
                                               FontSize="13"
                                               Margin="0,4,0,0">
                                        <Run Text="{Binding GiaTien, StringFormat={}{0:N0}}"/>
                                        <Run Text=" ₫"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <Button Grid.Column="1"
                                        Content="+"
                                        Width="32"
                                        Height="32"
                                        Command="{Binding DataContext.AddCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Background="#3498DB"
                                        Foreground="White"
                                        BorderThickness="0"
                                        FontWeight="Bold"
                                        Cursor="Hand"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- PHẢI: ĐÃ GỌI -->
            <Border Grid.Column="3"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="DANH SÁCH ĐÃ GỌI"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#222"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="{Binding ThongBao}"
                                   Foreground="Red"
                                   FontSize="13"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding DanhSachDaChon}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeight="32"
                              Background="White"
                              BorderThickness="0">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tên món"
                                                Binding="{Binding Ten_MH}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Đơn giá (₫)"
                                                Binding="{Binding GiaTien, StringFormat={}{0:N0}}"
                                                Width="110"/>

                            <DataGridTextColumn Header="Số lượng"
                                                Binding="{Binding SoLuong}"
                                                Width="70"/>

                            <DataGridTextColumn Header="Thành tiền (₫)"
                                                Binding="{Binding ThanhTien, StringFormat={}{0:N0}}"
                                                Width="120"/>

                            <DataGridTemplateColumn Header="Xóa" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="-"
                                                Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Background="#E74C3C"
                                                Foreground="White"
                                                Height="28"
                                                Width="28"
                                                BorderThickness="0"
                                                FontWeight="Bold"
                                                Cursor="Hand"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>