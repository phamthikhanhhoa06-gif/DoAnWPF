<Window x:Class="ql_ks.Views.HoaDonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ql_ks.Views"
        mc:Ignorable="d"
        Title="Hóa đơn"
        Width="1100" Height="700"
        WindowStartupLocation="CenterScreen"
        Background="#F0F2F5">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0" Background="#2C3E50">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="20,10,20,15">
                    <Separator Background="#34495E" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="txtNhanVien" Text="" FontSize="12" Foreground="#BDC3C7"/>
                        <TextBlock Text=" | " Foreground="#555" FontSize="12"/>
                        <TextBlock x:Name="txtChucVu" Text="" FontSize="12" Foreground="#7F8C8D"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel>
                    <TextBlock x:Name="txtTieuDe" Text="HÓA ĐƠN"
                               Foreground="White" FontSize="16" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,25,0,5"/>
                    <TextBlock x:Name="txtPhongInfo" Text=""
                               Foreground="#3498DB" FontSize="13"
                               HorizontalAlignment="Center" Margin="0,0,0,25"/>

                    <!-- Chỉ còn Hóa đơn tổng -->
                    <Button x:Name="btnHoaDonTong"
                            Content="HÓA ĐƠN TỔNG"
                            Background="#3498DB" Foreground="White"
                            BorderThickness="0" FontSize="15" FontWeight="Bold"
                            HorizontalAlignment="Stretch" Padding="20,12"
                            HorizontalContentAlignment="Left" Cursor="Hand"
                            IsEnabled="False"/>

                    <TextBlock Text="Các dịch vụ được đẩy từ&#x0a;menu Dịch vụ bên ngoài"
                               Foreground="#7F8C8D" FontSize="11"
                               TextWrapping="Wrap" Margin="20,20,20,0"
                               TextAlignment="Center" FontStyle="Italic"/>

                    <StackPanel Margin="20,30,20,0">
                        <Button Content="Đóng"
                                Click="BtnDong_Click"
                                Background="#E74C3C" Foreground="White"
                                BorderThickness="0" FontSize="14" FontWeight="Bold"
                                Padding="0,10" Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- NỘI DUNG: Chỉ hiển thị Hóa đơn tổng -->
        <ContentControl x:Name="MainContent" Grid.Column="1" Margin="30"/>
    </Grid>
</Window>