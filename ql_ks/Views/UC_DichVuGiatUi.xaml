<UserControl x:Class="ql_ks.Views.UC_DichVuGiatUi"

             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"

             xmlns:local="clr-namespace:ql_ks.Views"

             mc:Ignorable="d"

             d:DesignHeight="700" d:DesignWidth="1200">

    <Grid Margin="20" Background="#F3F5FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,10,0,16">
            <TextBlock Text="PHẦN MỀM QUẢN LÍ KHÁCH SẠN"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#30324A"/>
            <TextBlock Text="DỊCH VỤ GIẶT ỦI"
                       FontSize="16"
                       Foreground="#6B7280"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="450"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="12"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    Padding="20">

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <TextBlock Text="1. Phòng (đang có khách)"
                                   FontWeight="Bold"
                                   Foreground="#374151"
                                   Margin="0,0,0,8"/>

                        <ComboBox ItemsSource="{Binding DanhSachPhong}"
                                  SelectedValue="{Binding MaPhong}"
                                  DisplayMemberPath="HienThi"
                                  SelectedValuePath="MaPhong"
                                  Height="36"
                                  Padding="10,0"
                                  Background="#F9FAFB"
                                  BorderBrush="#CBD5E1"/>

                        <TextBlock Text="2. Loại giặt ủi"
                                   FontWeight="Bold"
                                   Foreground="#374151"
                                   Margin="0,18,0,8"/>

                        <ComboBox ItemsSource="{Binding DanhSachLoaiGiGui}"
                                  SelectedItem="{Binding SelectedLoaiGiGui}"
                                  DisplayMemberPath="Ten_LoaiGU"
                                  Height="36"
                                  Padding="10,0"
                                  Background="#F9FAFB"
                                  BorderBrush="#CBD5E1"/>

                        <TextBlock Text="3. Cân nặng (kg) - VD: 2,5"
                                   FontWeight="Bold"
                                   Foreground="#374151"
                                   Margin="0,18,0,8"/>

                        <TextBox Text="{Binding SoCanNangText, UpdateSourceTrigger=PropertyChanged}"
                                 Height="36"
                                 Padding="12,0"
                                 Background="#F9FAFB"
                                 BorderBrush="#CBD5E1"
                                 BorderThickness="1"/>

                        <TextBlock Text="4. Ngày nhận"
                                   FontWeight="Bold"
                                   Foreground="#374151"
                                   Margin="0,18,0,8"/>

                        <DatePicker SelectedDate="{Binding NgayBatDau}"
                                    Height="36"
                                    Padding="12,0"
                                    Background="#F9FAFB"
                                    BorderBrush="#CBD5E1"/>

                        <TextBlock Text="5. Ngày trả"
                                   FontWeight="Bold"
                                   Foreground="#374151"
                                   Margin="0,18,0,8"/>

                        <DatePicker SelectedDate="{Binding NgayKetThuc}"
                                    Height="36"
                                    Padding="12,0"
                                    Background="#F9FAFB"
                                    BorderBrush="#CBD5E1"/>

                        <TextBlock Margin="0,22,0,8">
                            <Run Text="Tạm tính: " FontWeight="Bold" Foreground="#555"/>
                            <Run Text="{Binding TongTien, StringFormat={}{0:N0}}"
                                 FontWeight="Bold"
                                 Foreground="Red"/>
                            <Run Text=" ₫"/>
                        </TextBlock>

                        <Button Content="➕ Thêm vào giỏ"
                                Command="{Binding ThemVaoGioCommand}"
                                Background="#3498DB"
                                Foreground="White"
                                Height="40"
                                Margin="0,10,0,0"
                                BorderThickness="0"
                                FontWeight="Bold"
                                Cursor="Hand"/>

                        <Button Content="🔄 Làm mới"
                                Command="{Binding LamMoiCommand}"
                                Background="#95A5A6"
                                Foreground="White"
                                Height="40"
                                Margin="0,8,0,0"
                                BorderThickness="0"
                                Cursor="Hand"/>

                        <TextBlock Text="{Binding ThongBao}"
                                   Foreground="Red"
                                   FontSize="13"
                                   Margin="0,14,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2"
                    Background="White"
                    CornerRadius="12"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    Padding="16">

                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="TRANG TÍNH ĐƠN GIẶT ỦI"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#111827"
                               Margin="0,0,0,14"/>

                    <DataGrid ItemsSource="{Binding DanhSachDaChon}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              RowHeight="34">
                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Phòng"
                                                Binding="{Binding MaPhong}"
                                                Width="70"/>

                            <DataGridTextColumn Header="Tên loại giặt ủi"
                                                Binding="{Binding Ten_LoaiGU}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Số kg"
                                                Binding="{Binding SoCanNang, StringFormat={}{0:N1}}"
                                                Width="80"/>

                            <DataGridTextColumn Header="Đơn giá (₫)"
                                                Binding="{Binding DonGia_LoaiGU, StringFormat={}{0:N0}}"
                                                Width="110"/>

                            <DataGridTextColumn Header="Thành tiền (₫)"
                                                Binding="{Binding ThanhTien, StringFormat={}{0:N0}}"
                                                Width="120"
                                                FontWeight="Bold"/>

                            <DataGridTemplateColumn Header="Trạng thái" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Xác Nhận"
                                                Click="BtnXacNhan_Click"
                                                Tag="{Binding}"
                                                Background="#27AE60"
                                                Foreground="White"
                                                Height="28"
                                                BorderThickness="0"
                                                FontWeight="Bold"
                                                Cursor="Hand"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Xóa" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✕"
                                                Command="{Binding DataContext.XoaKhoiGioCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Background="#E74C3C"
                                                Foreground="White"
                                                Height="28"
                                                Width="28"
                                                BorderThickness="0"
                                                FontWeight="Bold"
                                                Cursor="Hand"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>