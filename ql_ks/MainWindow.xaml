<Window x:Class="ql_ks.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ql_ks"
        xmlns:views="clr-namespace:ql_ks.Views"
        mc:Ignorable="d"
        Title="Phần mềm Quản Lý Khách Sạn"
        Height="800"
        Width="1400"
        Background="#F0F2F5">

    <!-- ============ RESOURCES: Style cho menu ============ -->
    <Window.Resources>

        <!-- Style cho RadioButton menu (có hover + active) -->
        <Style x:Key="MenuItemStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#BDC3C7"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderThickness="4,0,0,0"
                                BorderBrush="Transparent">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>

                            <!-- HOVER: khi rê chuột -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#34495E"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#3498DB"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>

                            <!-- ACTIVE: khi đang được chọn -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1ABC9C"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#16A085"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>

                            <!-- PRESSED: khi click giữ chuột -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#16A085"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style cho nút Đăng xuất -->
        <Style x:Key="LogoutButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#E74C3C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="43"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#C0392B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#A93226"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ============ LAYOUT CHÍNH ============ -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ SIDEBAR ============ -->
        <Border Grid.Column="0" Background="#2C3E50">
            <DockPanel LastChildFill="True">

                <!-- HEADER: Logo + Tiêu đề -->
                <StackPanel DockPanel.Dock="Top">
                    <Image Source="/Resources/HotelLogo.png"
                        Width="100"
                        HorizontalAlignment="Center"
                        Margin="0,30,0,10"/>

                    <TextBlock Text="HOTEL SYSTEM"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,5"/>

                    <!-- ✅ Hiển thị tên người dùng + vai trò -->
                    <TextBlock x:Name="txtUserInfo"
                               Foreground="#1ABC9C"
                               FontSize="12"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="10,0,10,30"/>
                </StackPanel>

                <!-- FOOTER: Nút Đăng xuất -->
                <StackPanel DockPanel.Dock="Bottom" Margin="20">
                    <Button Content="Đăng xuất"
                            Click="BtnLogout_Click"
                            Style="{StaticResource LogoutButtonStyle}"/>
                </StackPanel>

                <!-- MENU: dùng RadioButton để tự highlight trang active -->
                <StackPanel>
                    <RadioButton x:Name="menuTrangChu"
                                 Content="TRANG CHỦ"
                                 GroupName="SidebarMenu"
                                 IsChecked="True"
                                 Style="{StaticResource MenuItemStyle}"
                                 Click="BtnTrangChu_Click"/>

                    <RadioButton x:Name="menuDichVuAnUong"
                                 Content="DỊCH VỤ ĂN UỐNG"
                                 GroupName="SidebarMenu"
                                 Style="{StaticResource MenuItemStyle}"
                                 Click="BtnDichVuAnUong_Click"/>

                    <RadioButton x:Name="menuDichVuGiatUi"
                                 Content="DỊCH VỤ GIẶT ỦI"
                                 GroupName="SidebarMenu"
                                 Style="{StaticResource MenuItemStyle}"
                                 Click="Button_Click"/>

                    <RadioButton x:Name="menuDichVuDiChuyen"
                                 Content="DỊCH VỤ DI CHUYỂN"
                                 GroupName="SidebarMenu"
                                 Style="{StaticResource MenuItemStyle}"
                                 Click="Button_Click_1"/>

                    <RadioButton x:Name="menuTraCuuQuanLy"
                                 Content="TRA CỨU QUẢN LÝ"
                                 GroupName="SidebarMenu"
                                 Style="{StaticResource MenuItemStyle}"
                                 Click="Button_Click_2"/>

                    <RadioButton x:Name="menuBaoCao"
                                 Content="BÁO CÁO, THỐNG KÊ"
                                 GroupName="SidebarMenu"
                                 Style="{StaticResource MenuItemStyle}"
                                 Click="Button_Click_3"/>

                    <RadioButton x:Name="menuThongTin"
                                 Content="THÔNG TIN"
                                 GroupName="SidebarMenu"
                                 Style="{StaticResource MenuItemStyle}"/>
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- ============ NỘI DUNG CHÍNH ============ -->
        <ContentControl x:Name="MainContent" Grid.Column="1" Margin="30"/>
    </Grid>
</Window>