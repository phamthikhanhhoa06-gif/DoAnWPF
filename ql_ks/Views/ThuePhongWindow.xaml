<Window x:Class="ql_ks.Views.ThuePhongWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Thuê phòng"
        Width="800" Height="650"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">

    <Window.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#7F8C8D"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="BorderBrush" Value="#DDD"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style x:Key="DatePickerStyle" TargetType="DatePicker">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="BorderBrush" Value="#DDD"/>
        </Style>
    </Window.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TIÊU ĐỀ -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,20">
            <TextBlock Text="THUÊ PHÒNG" FontSize="22" FontWeight="Bold" 
                       Foreground="#2C3E50" HorizontalAlignment="Center"/>
            <Rectangle Height="3" Width="200" Fill="#27AE60" 
                       HorizontalAlignment="Center" Margin="0,5,0,0"/>
            <TextBlock Text="{Binding ThongBao}" FontSize="12" Foreground="#999" 
                       HorizontalAlignment="Center" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- NỘI DUNG -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- CỘT TRÁI -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="THÔNG TIN HÓA ĐƠN" FontSize="14" FontWeight="Bold" 
                               Foreground="#2C3E50" Margin="0,0,0,15"/>
                    <Separator Background="#E0E0E0" Margin="0,0,0,15"/>

                    <TextBlock Text="Mã hóa đơn" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Text="{Binding MaHD}" Style="{StaticResource ValueStyle}"/>

                    <TextBlock Text="Ngày lập hóa đơn" Style="{StaticResource LabelStyle}"/>
                    <DatePicker SelectedDate="{Binding NgayLapHD}" Style="{StaticResource DatePickerStyle}"/>

                    <TextBlock Text="Nhân viên lập" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Text="{Binding TenNhanVien}" Style="{StaticResource ValueStyle}"/>

                    <Separator Background="#E0E0E0" Margin="0,5,0,15"/>

                    <TextBlock Text="THÔNG TIN KHÁCH HÀNG" FontSize="14" FontWeight="Bold" 
                               Foreground="#2C3E50" Margin="0,0,0,15"/>

                    <TextBlock Text="Số CMND / CCCD" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding CMND, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource InputStyle}"
                             LostFocus="TxtCMND_LostFocus"/>

                    <TextBlock Text="Họ và tên" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding TenKhachHang, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource InputStyle}"/>

                    <TextBlock Text="Số điện thoại" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding SoDienThoaiKH, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource InputStyle}"/>
                </StackPanel>

                <!-- CỘT PHẢI -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="THÔNG TIN PHÒNG" FontSize="14" FontWeight="Bold" 
                               Foreground="#2C3E50" Margin="0,0,0,15"/>
                    <Separator Background="#E0E0E0" Margin="0,0,0,15"/>

                    <TextBlock Text="Mã phòng" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Text="{Binding MaPhong}" Style="{StaticResource ValueStyle}" FontSize="20"/>

                    <TextBlock Text="Loại phòng" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Text="{Binding LoaiPhong}" Style="{StaticResource ValueStyle}"/>

                    <TextBlock Text="Đơn giá (VNĐ/ngày)" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Style="{StaticResource ValueStyle}">
                        <Run Text="{Binding DonGiaPhong, StringFormat={}{0:N0}}"/>
                        <Run Text=" VNĐ" Foreground="#999"/>
                    </TextBlock>

                    <Separator Background="#E0E0E0" Margin="0,5,0,15"/>

                    <TextBlock Text="Ngày nhận phòng" Style="{StaticResource LabelStyle}"/>
                    <DatePicker SelectedDate="{Binding NgayNhan}" Style="{StaticResource DatePickerStyle}"/>

                    <TextBlock Text="Ngày trả phòng" Style="{StaticResource LabelStyle}"/>
                    <DatePicker SelectedDate="{Binding NgayTra}" Style="{StaticResource DatePickerStyle}"/>

                    <TextBlock Text="Số ngày lưu trú" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Style="{StaticResource ValueStyle}">
                        <Run Text="{Binding SoNgay}"/>
                        <Run Text=" ngày" Foreground="#999"/>
                    </TextBlock>

                    <Separator Background="#E0E0E0" Margin="0,5,0,15"/>

                    <TextBlock Text="TỔNG TIỀN" FontSize="14" FontWeight="Bold" 
                               Foreground="#E74C3C" Margin="0,0,0,5"/>
                    <Border Background="#FDEDEC" CornerRadius="8" Padding="15,10">
                        <TextBlock FontSize="24" FontWeight="Bold" Foreground="#E74C3C" HorizontalAlignment="Center">
                            <Run Text="{Binding TongTien}"/>
                            <Run Text=" VNĐ" FontSize="14"/>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- NÚT DƯỚI -->
        <Border Grid.Row="2" Margin="0,15,0,0" Padding="0,10,0,0"
                BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Hủy" 
                        Click="BtnHuy_Click"
                        HorizontalAlignment="Left"
                        Background="#95A5A6" Foreground="White" 
                        Padding="30,10" FontSize="14" FontWeight="Bold"
                        BorderThickness="0" Cursor="Hand"/>

                <Button Grid.Column="1" Content="✅ Xác nhận" 
                        Click="BtnXacNhan_Click"
                        Background="#27AE60" Foreground="White" 
                        Padding="30,10" FontSize="14" FontWeight="Bold"
                        BorderThickness="0" Cursor="Hand"/>
            </Grid>
        </Border>
    </Grid>
</Window>