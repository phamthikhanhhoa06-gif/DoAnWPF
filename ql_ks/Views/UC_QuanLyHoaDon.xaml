<UserControl x:Class="ql_ks.Views.UC_QuanLyHoaDon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ql_ks.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             TextElement.FontWeight="Regular"
             TextElement.FontSize="13"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="Auto"
             Background="{DynamicResource MaterialDesignPaper}"
             FontFamily="{DynamicResource MaterialDesignFont}">
             
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- HEADER -->
        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" 
                   Text="QUẢN LÝ HÓA ĐƠN &amp; LƯU TRÚ" FontSize="24" FontWeight="Bold" Foreground="#3F51B5" Margin="0,0,0,20"/>
                   
        <!-- FORM PANEL -->
        <ScrollViewer Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,20,0">
            <materialDesign:Card Padding="15">
                <StackPanel>
                    <TextBlock Text="Nghiệp vụ lưu trú" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,20"/>
                    
                    <TextBox Text="{Binding MaHD, UpdateSourceTrigger=PropertyChanged}" 
                             materialDesign:HintAssist.Hint="Mã Hóa Đơn (Tự nhập)" 
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                             Margin="0,0,0,15"/>
                             
                    <ComboBox ItemsSource="{Binding ListKhachHang}"
                              SelectedItem="{Binding SelectedKhachHang}"
                              DisplayMemberPath="HoTen_KH"
                              materialDesign:HintAssist.Hint="Khách Hàng" 
                              Style="{StaticResource MaterialDesignFloatingHintComboBox}" 
                              Margin="0,0,0,15"/>
                              
                    <ComboBox ItemsSource="{Binding ListNhanVien}"
                              SelectedItem="{Binding SelectedNhanVien}"
                              DisplayMemberPath="HoTen_NV"
                              materialDesign:HintAssist.Hint="Nhân viên xuất HĐ" 
                              Style="{StaticResource MaterialDesignFloatingHintComboBox}" 
                              Margin="0,0,0,15"/>
                              
                    <ComboBox ItemsSource="{Binding ListPhong}"
                              SelectedItem="{Binding SelectedPhong}"
                              materialDesign:HintAssist.Hint="Chọn Phòng" 
                              Style="{StaticResource MaterialDesignFloatingHintComboBox}" 
                              Margin="0,0,0,15">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Ma_Phong, StringFormat='Phòng số: {0}'}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                              
                    <DatePicker SelectedDate="{Binding NgayNhanPhong, UpdateSourceTrigger=PropertyChanged}"
                                materialDesign:HintAssist.Hint="Ngày nhận phòng"
                                Style="{StaticResource MaterialDesignFloatingHintDatePicker}"
                                Margin="0,0,0,15"/>
                                
                    <DatePicker SelectedDate="{Binding NgayTraPhong, UpdateSourceTrigger=PropertyChanged}"
                                materialDesign:HintAssist.Hint="Ngày trả phòng (Khi Check-out)"
                                Style="{StaticResource MaterialDesignFloatingHintDatePicker}"
                                Margin="0,0,0,15"/>
                    
                    <ComboBox SelectedValue="{Binding TinhTrangHD, UpdateSourceTrigger=PropertyChanged}"
                              SelectedValuePath="Content"
                              materialDesign:HintAssist.Hint="Tình trạng HĐ" 
                              Style="{StaticResource MaterialDesignFloatingHintComboBox}" 
                              Margin="0,0,0,15">
                        <ComboBoxItem Content="Chưa thanh toán"/>
                        <ComboBoxItem Content="Đã thanh toán"/>
                    </ComboBox>
                    
                    <TextBox Text="{Binding TriGiaDaTinh, StringFormat={}{0:N0} đ, UpdateSourceTrigger=PropertyChanged}" 
                             materialDesign:HintAssist.Hint="Tổng tiền thanh toán"
                             IsReadOnly="True"
                             FontWeight="Bold" Foreground="#E74C3C"
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                             Margin="0,0,0,30"/>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <Button Grid.Row="0" Grid.Column="0" Command="{Binding CheckInCommand}" Content="Nhận phòng" Margin="5" Background="#2ECC71" BorderBrush="#2ECC71" Foreground="White" Style="{StaticResource MaterialDesignFlatDarkBgButton}"/>
                        <Button Grid.Row="0" Grid.Column="1" Command="{Binding CheckOutCommand}" Content="Thanh toán &amp; Trả P." Margin="5" Background="#F1C40F" BorderBrush="#F1C40F" Foreground="Black" Style="{StaticResource MaterialDesignFlatDarkBgButton}"/>
                        <Button Grid.Row="1" Grid.Column="0" Command="{Binding DeleteCommand}" Content="Xóa HĐ" Margin="5" Background="#E74C3C" BorderBrush="#E74C3C" Foreground="White" Style="{StaticResource MaterialDesignFlatDarkBgButton}"/>
                        <Button Grid.Row="1" Grid.Column="1" Command="{Binding ClearCommand}" Content="Làm mới" Margin="5" Style="{StaticResource MaterialDesignOutlinedButton}"/>
                    </Grid>
                </StackPanel>
            </materialDesign:Card>
        </ScrollViewer>
        
        <!-- DATAGRID -->
        <materialDesign:Card Grid.Row="1" Grid.Column="1" Padding="10">
            <DataGrid ItemsSource="{Binding ListHoaDon}" 
                      SelectedItem="{Binding SelectedHoaDon}"
                      AutoGenerateColumns="False" 
                      CanUserAddRows="False" 
                      IsReadOnly="True"
                      materialDesign:DataGridAssist.CellPadding="10 8 8 8"
                      materialDesign:DataGridAssist.ColumnHeaderPadding="8">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã HĐ" Binding="{Binding MaHD}"/>
                    <DataGridTextColumn Header="Khách hàng" Binding="{Binding TenKhachHang}"/>
                    <DataGridTextColumn Header="Phòng" Binding="{Binding MaPhong}"/>
                    <DataGridTextColumn Header="Tình trạng" Binding="{Binding TinhTrang}"/>
                    <DataGridTextColumn Header="Tổng tiền" Binding="{Binding TriGia, StringFormat={}{0:N0} đ}"/>
                    <DataGridTemplateColumn Header="Ngày trả">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TraPhong, StringFormat=dd/MM/yyyy}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>
    </Grid>
</UserControl>
