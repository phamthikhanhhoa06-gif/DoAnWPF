<UserControl x:Class="ql_ks.Views.UC_BaoCaoThongKeKhachHang"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ql_ks.Views"
             mc:Ignorable="d" 
            d:DesignHeight="700" d:DesignWidth="1200"
             Background="#F5F7FA">

    <UserControl.Resources>
        <local:BieuDoToPieSliceConverter x:Key="PieSliceConverter"/>

        <Style x:Key="CenterAlign" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="RightAlign" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TIÊU ĐỀ -->
        <TextBlock Grid.Row="0" Text="PHẦN MỀM QUẢN LÍ KHÁCH SẠN" 
                   FontSize="26" FontWeight="Bold" Foreground="#30324A" 
                   HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <!-- THANH LỌC -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" 
                BorderBrush="#E5E7EB" BorderThickness="1" Padding="15" Margin="0,0,0,10">
            <WrapPanel VerticalAlignment="Center">
                <!-- Nút 1: Ngày bắt đầu -->
                <TextBlock Text="Từ ngày:" VerticalAlignment="Center" 
                           Margin="0,0,8,0" Foreground="#555" FontWeight="Bold"/>
                <DatePicker SelectedDate="{Binding NgayBatDau}" 
                            Width="140" Height="32" Margin="0,0,20,0"/>

                <!-- Nút 2: Ngày kết thúc -->
                <TextBlock Text="Đến ngày:" VerticalAlignment="Center" 
                           Margin="0,0,8,0" Foreground="#555" FontWeight="Bold"/>
                <DatePicker SelectedDate="{Binding NgayKetThuc}" 
                            Width="140" Height="32" Margin="0,0,20,0"/>

                <!-- Nút 3: Hiện báo cáo -->
                <Button Content="📊 Hiện báo cáo" Command="{Binding TimKiemCommand}" 
                        Background="#3498DB" Foreground="White" 
                        Padding="15,6" Height="32" BorderThickness="0" 
                        FontWeight="Bold" FontSize="13" Cursor="Hand" Margin="0,0,10,0"/>

                <!-- Nút 4: Xuất / In báo cáo -->
                <Button Content="🖨️ Xuất / In báo cáo" Click="BtnXuatBaoCao_Click"
                        Background="#E74C3C" Foreground="White" Padding="15,6" 
                        Height="32" BorderThickness="0" FontWeight="Bold" 
                        FontSize="13" Cursor="Hand"/>
            </WrapPanel>
        </Border>

        <!-- THÔNG BÁO + TỔNG QUAN -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" 
                BorderBrush="#E5E7EB" BorderThickness="1" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding ThongBao}" 
                           FontSize="13" Foreground="#666" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,30,0">
                    <TextBlock Text="Tổng khách hàng: " FontSize="13" 
                               Foreground="#555" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TongSoKhach}" FontSize="16" 
                               FontWeight="Bold" Foreground="#2980B9" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="Tổng doanh thu: " FontSize="13" 
                               Foreground="#555" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TongDoanhThu, StringFormat={}{0:N0} VNĐ}" 
                               FontSize="16" FontWeight="Bold" Foreground="#E74C3C" 
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- NỘI DUNG CHÍNH -->
        <Border Grid.Row="3" Background="White" CornerRadius="12" 
                BorderBrush="#E5E7EB" BorderThickness="1" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- CỘT TRÁI: BẢNG CHI TIẾT -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,15,0">
                    <StackPanel>
                        <TextBlock Text="CHI TIẾT DOANH THU THEO KHÁCH HÀNG" 
                                   FontSize="15" FontWeight="Bold" 
                                   Foreground="#2C3E50" Margin="0,0,0,10"/>

                        <DataGrid ItemsSource="{Binding ChiTietKhachHangList}" 
                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                  IsReadOnly="True" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal" 
                                  Background="White" RowHeight="32"
                                  AlternatingRowBackground="#F8F9FA"
                                  MaxHeight="500">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="STT" Width="50" 
                                    Binding="{Binding STT}" 
                                    ElementStyle="{StaticResource CenterAlign}"/>
                                <DataGridTextColumn Header="Mã KH" Width="65" 
                                    Binding="{Binding MaKH}" 
                                    ElementStyle="{StaticResource CenterAlign}"/>
                                <DataGridTextColumn Header="Họ tên" Width="*" 
                                    Binding="{Binding HoTen}"/>
                                <DataGridTextColumn Header="SĐT" Width="110" 
                                    Binding="{Binding SoDienThoai}" 
                                    ElementStyle="{StaticResource CenterAlign}"/>
                                <DataGridTextColumn Header="Số HĐ" Width="60" 
                                    Binding="{Binding SoHoaDon}" 
                                    ElementStyle="{StaticResource CenterAlign}"/>
                                <DataGridTextColumn Header="Doanh thu (VNĐ)" Width="130" 
                                    Binding="{Binding DoanhThu, StringFormat={}{0:N0}}" 
                                    ElementStyle="{StaticResource RightAlign}"/>
                                <DataGridTextColumn Header="Tỷ lệ" Width="80" 
                                    Binding="{Binding TyLe, StringFormat={}{0:P1}}" 
                                    ElementStyle="{StaticResource CenterAlign}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>

                <!-- CỘT PHẢI: BIỂU ĐỒ TRÒN -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="BIỂU ĐỒ TỶ LỆ DOANH THU" 
                                   FontSize="15" FontWeight="Bold" Foreground="#2C3E50" 
                                   HorizontalAlignment="Center" Margin="0,0,0,10"/>

                        <TextBlock Text="(Đơn vị tính: VNĐ)" FontSize="11" Foreground="#999" 
                                   HorizontalAlignment="Center" Margin="0,0,0,15"/>

                        <!-- BIỂU ĐỒ TRÒN -->
                        <Border Background="#F8F9FA" CornerRadius="10" Padding="10" Margin="0,0,0,15">
                            <local:PieChartControl 
                                Width="280" Height="280"
                                ItemsSource="{Binding BieuDoKhachHangList, 
                                    Converter={StaticResource PieSliceConverter}}"/>
                        </Border>

                        <!-- CHÚ THÍCH (LEGEND) -->
                        <Border Background="#F8F9FA" CornerRadius="8" Padding="10">
                            <StackPanel>
                                <TextBlock Text="Chú thích:" FontWeight="Bold" 
                                           Foreground="#555" Margin="0,0,0,8" FontSize="12"/>
                                <ItemsControl ItemsSource="{Binding BieuDoKhachHangList}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="18"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Ô màu -->
                                                <Border Grid.Column="0" Width="14" Height="14" 
                                                        CornerRadius="3" Background="{Binding Mau}" 
                                                        Margin="0,0,6,0"/>

                                                <!-- Tên khách hàng -->
                                                <TextBlock Grid.Column="1" 
                                                           Text="{Binding TenKhachHang}" 
                                                           FontSize="11" Foreground="#555" 
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>

                                                <!-- Tỷ lệ + Doanh thu -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" 
                                                            Margin="8,0,0,0">
                                                    <TextBlock FontSize="11" Foreground="#888" 
                                                               VerticalAlignment="Center">
                                                        <Run Text="{Binding TyLe, StringFormat={}{0:P1}}"/>
                                                        <Run Text=" - "/>
                                                        <Run Text="{Binding DoanhThu, StringFormat={}{0:N0}}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
