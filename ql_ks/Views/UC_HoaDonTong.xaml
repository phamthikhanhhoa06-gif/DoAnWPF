<UserControl x:Class="ql_ks.Views.UC_HoaDonTong"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ql_ks.Views"
             mc:Ignorable="d" 
           d:DesignHeight="650"
             d:DesignWidth="750"
             Background="#F5F7FA">

    <UserControl.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#7F8C8D"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="MoneyTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#7F8C8D"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="MoneyValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TIÊU ĐỀ -->
        <StackPanel Grid.Row="0"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,15">

            <TextBlock Text="HÓA ĐƠN TỔNG"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#2C3E50"
                       HorizontalAlignment="Center"/>

            <Rectangle Height="3"
                       Width="200"
                       Fill="#3498DB"
                       HorizontalAlignment="Center"
                       Margin="0,5,0,0"/>

            <TextBlock Text="{Binding ThongBao}"
                       FontSize="12"
                       Foreground="#999"
                       HorizontalAlignment="Center"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- THÔNG TIN HÓA ĐƠN / KHÁCH / PHÒNG -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="8"
                Padding="15"
                Margin="0,0,0,15"
                BorderBrush="#E0E0E0"
                BorderThickness="1">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- THÔNG TIN HÓA ĐƠN -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="THÔNG TIN HÓA ĐƠN"
                               FontWeight="Bold"
                               FontSize="14"
                               Foreground="#2C3E50"
                               Margin="0,0,0,10"/>

                    <TextBlock Text="Mã hóa đơn" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Text="{Binding MaHD}" Style="{StaticResource ValueStyle}"/>

                    <TextBlock Text="Ngày lập" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Text="{Binding NgayLapHD}" Style="{StaticResource ValueStyle}"/>

                    <TextBlock Text="Tình trạng" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Text="{Binding TinhTrangHD}"
                               Style="{StaticResource ValueStyle}"
                               Foreground="#E67E22"/>

                    <TextBlock Text="Nhân viên lập" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Text="{Binding TenNhanVien}" Style="{StaticResource ValueStyle}"/>
                </StackPanel>

                <!-- THÔNG TIN KHÁCH HÀNG -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="THÔNG TIN KHÁCH HÀNG"
                               FontWeight="Bold"
                               FontSize="14"
                               Foreground="#2C3E50"
                               Margin="0,0,0,10"/>

                    <TextBlock Text="Họ và tên" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Text="{Binding TenKhachHang}" Style="{StaticResource ValueStyle}"/>

                    <TextBlock Text="Số điện thoại" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Text="{Binding SoDienThoaiKH}" Style="{StaticResource ValueStyle}"/>

                    <TextBlock Text="CMND / CCCD" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Text="{Binding CMND}" Style="{StaticResource ValueStyle}"/>
                </StackPanel>

                <!-- THÔNG TIN PHÒNG -->
                <StackPanel Grid.Column="4">
                    <TextBlock Text="THÔNG TIN PHÒNG"
                               FontWeight="Bold"
                               FontSize="14"
                               Foreground="#2C3E50"
                               Margin="0,0,0,10"/>

                    <TextBlock Text="Mã phòng" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Text="{Binding MaPhong}"
                               Style="{StaticResource ValueStyle}"
                               FontSize="20"/>

                    <TextBlock Text="Loại phòng" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Text="{Binding LoaiPhong}" Style="{StaticResource ValueStyle}"/>

                    <TextBlock Text="Đơn giá phòng" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Style="{StaticResource ValueStyle}">
                        <Run Text="{Binding DonGiaPhong}"/>
                        <Run Text=" VNĐ/ngày"/>
                    </TextBlock>

                    <TextBlock Text="Tình trạng phòng" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Text="{Binding TinhTrangPhong}" Style="{StaticResource ValueStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- NỘI DUNG CHÍNH -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TỔNG HỢP TIỀN -->
            <Grid Grid.Row="0" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="10" BorderBrush="#E0E0E0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Lưu trú" Style="{StaticResource MoneyTitleStyle}"/>
                        <TextBlock Style="{StaticResource MoneyValueStyle}">
                            <Run Text="{Binding TongLuuTru}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="10" BorderBrush="#E0E0E0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Ăn uống" Style="{StaticResource MoneyTitleStyle}"/>
                        <TextBlock Style="{StaticResource MoneyValueStyle}">
                            <Run Text="{Binding TongAnUong}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Background="White" CornerRadius="8" Padding="10" BorderBrush="#E0E0E0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Giặt ủi" Style="{StaticResource MoneyTitleStyle}"/>
                        <TextBlock Style="{StaticResource MoneyValueStyle}">
                            <Run Text="{Binding TongGiatUi}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Grid.Column="6" Background="White" CornerRadius="8" Padding="10" BorderBrush="#E0E0E0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Di chuyển" Style="{StaticResource MoneyTitleStyle}"/>
                        <TextBlock Style="{StaticResource MoneyValueStyle}">
                            <Run Text="{Binding TongDiChuyen}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Grid.Column="8" Background="#FDEDEC" CornerRadius="8" Padding="10" BorderBrush="#E74C3C" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Tổng cộng"
                                   FontSize="13"
                                   Foreground="#E74C3C"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#E74C3C"
                                   HorizontalAlignment="Center">
                            <Run Text="{Binding TongCong}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- BẢNG CHI TIẾT -->
            <Border Grid.Row="1"
                    Background="White"
                    CornerRadius="8"
                    Padding="10"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1">

                <DataGrid ItemsSource="{Binding ChiTietList}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0"
                          RowHeaderWidth="0"
                          FontSize="13">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Dịch vụ"
                                            Binding="{Binding LoaiDichVu}"
                                            Width="110"/>

                        <DataGridTextColumn Header="Nội dung"
                                            Binding="{Binding NoiDung}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Số lượng"
                                            Binding="{Binding SoLuong}"
                                            Width="100"/>

                        <DataGridTextColumn Header="Đơn giá"
                                            Binding="{Binding DonGia}"
                                            Width="150"/>

                        <DataGridTextColumn Header="Thành tiền"
                                            Binding="{Binding ThanhTien}"
                                            Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- NÚT DƯỚI -->
        <Border Grid.Row="3"
                Margin="0,15,0,0"
                Padding="0,10,0,0"
                BorderBrush="#E0E0E0"
                BorderThickness="0,1,0,0">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Làm mới"
                        Command="{Binding LamMoiCommand}"
                        Background="#95A5A6"
                        Foreground="White"
                        Padding="25,10"
                        FontSize="14"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"/>

                <Button Grid.Column="2"
                        Content="Đóng"
                        Click="BtnDong_Click"
                        Background="#7F8C8D"
                        Foreground="White"
                        Padding="25,10"
                        FontSize="14"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"/>

                <Button Grid.Column="4"
                        Content="Thanh toán"
                        Command="{Binding ThanhToanCommand}"
                        Background="#E74C3C"
                        Foreground="White"
                        Padding="30,10"
                        FontSize="14"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>